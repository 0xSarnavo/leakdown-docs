{
  "name": "leakdown-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Leakdown documentation site (hosted separately from leakdown-website)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "corpus": "node scripts/build-corpus.mjs",
    "icon": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/build-icon.mjs",
    "eval:ask": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/eval-ask.mjs",
    "tune:ask": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/tune-ask.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
